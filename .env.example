# Public Supabase project configuration (safe for browser use)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional server-only integrations. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=JusticeConnect <notifications@example.co.za>
SENTRY_DSN=
# Generate with: openssl rand -hex 32. Required for encrypting practitioner registration numbers.
CREDENTIAL_ENCRYPTION_KEY=

# Do not set a service-role key unless a reviewed server-only job requires it.
